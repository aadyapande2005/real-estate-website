{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "controllers/**/*.ts", "lib/**/*.ts", "middleware/**/*.ts", "routes/**/*.ts"],
  "exclude": ["node_modules", "prisma/generated"]
}